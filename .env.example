# Не добавляйте настоящие ключи в GitHub. Скопируйте в .env и подставьте свои значения.

# ── LLM (необязательно) ─────────────────────────────────────────────────────
# Любой OpenAI-совместимый провайдер с моделью ОТКРЫТЫХ ВЕСОВ (требование кейса):
# vLLM, Ollama, LM Studio, OpenRouter и т.п. Без ключа решение работает
# полностью детерминированно, без внешней модели.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# ── Демо-учётные записи (тестовые PIN для входа и API) ──────────────────────
DEMO_CLIENT_PIN=1234
DEMO_BANK_PIN=0007
